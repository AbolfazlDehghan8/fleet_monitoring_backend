# Copy this file to .env and fill in real values. Never commit .env.
SECRET_KEY=change-me-generate-a-new-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
DB_NAME=fleet_db
DB_USER=fleet_user
DB_PASSWORD=change-me
DB_HOST=pgbouncer
DB_PORT=6432
REDIS_URL=redis://localhost:6379/1
RABBITMQ_URL=amqp://fleet_user:fleet_password@localhost:5672/fleet_vhost
CELERY_RESULT_BACKEND_URL=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=False
TELEMETRY_RETENTION_DAYS=365
ENABLE_HTTPS_ENFORCEMENT=False

OTEL_TRACING_ENABLED=True
OTEL_SERVICE_NAME=fleet-monitoring-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_TRACES_SAMPLER_RATIO=1.0
OTEL_CONSOLE_EXPORT=False
SERVICE_VERSION=1.0.0
DEPLOYMENT_ENVIRONMENT=development