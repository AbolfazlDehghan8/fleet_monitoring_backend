# Copy this file to .env and fill in real values. Never commit .env.
SECRET_KEY=change-me-generate-a-new-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DB_NAME=fleet_db
DB_USER=fleet_user
DB_PASSWORD=change-me
DB_HOST=pgbouncer
DB_PORT=6432
REDIS_URL=redis://localhost:6379/1
RABBITMQ_URL=amqp://fleet_user:fleet_password@localhost:5672/fleet_vhost
CELERY_RESULT_BACKEND_URL=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=False
TELEMETRY_RETENTION_DAYS=365
ENABLE_HTTPS_ENFORCEMENT=False